        {
          "info": {
            "name": "getMeterRead",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-prd.aemo.local/NEMRetail/B2MMessagingSync/getMeterRead",
            "headers": [
              {
                "name": "X-initiatingParticipantID",
                "value": ""
              },
              {
                "name": "X-market",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "NMI",
                "value": "",
                "type": "query"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Format - YYYY-MM-DD. Start Date of the meter data request period (inclusive)."
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "Format - YYYY-MM-DD. End Date of the meter data request period (inclusive)."
              },
              {
                "name": "meterType",
                "value": "",
                "type": "query",
                "description": "Allowed values are\t'I' - Interval , 'C' - Consumption (Basic)"
              },
              {
                "name": "meterData",
                "value": "",
                "type": "query",
                "description": "Allowed values are\t'AO' - Current readings, 'AH' - Current and historical readings"
              },
              {
                "name": "asAtDate",
                "value": "",
                "type": "query",
                "description": "Format - YYYY-MM-DD hh:mi:ss:000. Provides the ability for the consumer to request metering data 'as at' a point in time."
              },
              {
                "name": "intervalLength",
                "value": "",
                "type": "query",
                "description": "Relevant only for interval data. Defines the resolution that the meter reads should be returned in. Possible values are '30' or 'SD'."
              },
              {
                "name": "activeEnergy",
                "value": "",
                "type": "query",
                "description": "Applicable to interval data only. Possible values are 'N' or 'Y'."
              },
              {
                "name": "AEMOSubs",
                "value": "",
                "type": "query",
                "description": "Applicable to interval data only. Possible values are 'N' or 'Y'."
              }
            ]
          },
          "docs": "This resource allow to search for and retrieve metering data loaded into the Enterprise MDM"
        },

        {
          "id": "fb521ee9-90a0-4de7-b2fc-3aa6974d9a99",
          "name": "Get status of core e-Hub applications",
          "request": {
            "name": "Get status of core e-Hub applications",
            "description": {
              "content": "Returns response code to state if the core e-Hub applications are available / operational. This API/resource will be used by the Participants to\n-  Test if the Participant application / gateway is able to establish connectivity with the e-Hub and/or\n- Validate if the SSL configuration / certificates are valid and/or\n- Check if the core e-Hub applications are available",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ping"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "initiatingParticipantID",
                  "value": "<string>",

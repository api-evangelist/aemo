                "value": "",
                "type": "query",
                "description": "GUID generated by the application"
              },
              {
                "name": "codeChallenge",
                "value": "",
                "type": "query",
                "description": "Base64 URL-encoded SHA-256 hash of the code verifier"
              }
            ]

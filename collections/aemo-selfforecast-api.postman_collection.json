  "info": {
    "_postman_id": "d3ec48a4-66b4-47ab-b067-f4e37b91e937",
    "name": "Self Forecast API",
    "description": "## Introduction\nThe Self forecasting API is used by participants who wish to submit their Solar or Wind Forecasts for a DUID to AEMO.\n\nFor details on how to get access and business rules for this API:",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:19:45.000Z",
    "updatedAt": "2026-10-21T20:19:45.000Z",

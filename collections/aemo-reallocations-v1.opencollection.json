          "http": {
            "method": "GET",
            "url": "https://api-prd.aemo.local/ws/NEMWholesale/reallocations/getRegions",
            "headers": [
              {
                "name": "X-initiatingParticipantID",
                "value": ""
              },
              {
                "name": "X-market",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              }
            ]
          },
          "docs": "The getRegions API retrieves a list of regions and associated descriptive names.        Possible values are as follows-\n- New South Wales\n- Queensland\n- South Australia\n- Tasmania\n- Victoria"
        },
        {
          "info": {
            "name": "submitReallocation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-prd.aemo.local/ws/NEMWholesale/reallocations/submitReallocation",
            "headers": [
              {
                "name": "X-initiatingParticipantID",
                "value": ""
              },
              {
                "name": "X-market",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a reallocation and sets the status to SUBMIT. The API creates an ID in the format “<YYYYMMDD>.RS<NNNN>“ where-\n- <YYYYMMDD> is the current system date \n- <NNNN> is the consistently increasing sequence number for reallocations created on the specific date including leading zeros."
        }

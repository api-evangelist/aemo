            "name": "Acknowledge the Dispatch Instruction",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api-gwy-prd.aemo.local/WEM/v1/DSPDispatchInstruction/dispatchInstructionAck/:dispatchInstructionId",
            "headers": [
              {
                "name": "x-initiatingParticipantId",
                "value": ""
              },
              {
                "name": "x-market",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "dispatchInstructionId",
                "value": "",

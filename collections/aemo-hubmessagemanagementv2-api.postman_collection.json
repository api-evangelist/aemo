          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "description": "(Required) The ID of the Initiating Participant",
                "key": "X-initiatingParticipantID",
                "value": "<string>"
              },
              {
                "description": "unique ID for the transaction",
                "key": "X-transactionID",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/getAlerts?alertType=B2BStopFile&queryParticipantID=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "getAlerts"
              ],
              "query": [
                {
                  "description": "'B2BStopFile' or 'B2MStopFile'. If not provided, default to 'B2BStopFile'",
                  "key": "alertType",
                  "value": "B2BStopFile"
                },
                {
                  "description": "Used for B2B alerts only. If provided, the alerts for that particular participant is returned. This value is ignored for B2M alerts.",
                  "key": "queryParticipantID",
                  "value": "<string>"
                }
              ]
            },
            "description": "Receive B2B and B2M stop file alerts"
          },
